PORT=5000
NODE_ENV=development

# Supabase Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWT Authentication Secret (Dapat disalin dari Supabase: Project Settings -> API -> JWT Settings -> JWT Secret, atau random 64-char string)
JWT_SECRET=your-jwt-secret-key-here
JWT_EXPIRES_IN=7d

# Client CORS URL
CLIENT_URL=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000

# E-Commerce Configuration
FREE_SHIPPING_THRESHOLD=500000
DEFAULT_SHIPPING_COST=25000
QRIS_ADMIN_FEE=2500
